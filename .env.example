# QIE network config (public: safe to ship to the browser). Defaults match
# docs.qie.digital, so these are optional overrides. Chain ids (1983 testnet,
# 1990 mainnet) are protocol constants and not configurable.
VITE_QIE_TESTNET_RPC=https://rpc1testnet.qie.digital/
VITE_QIE_TESTNET_EXPLORER=https://testnet.qie.digital

VITE_QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital/
VITE_QIE_MAINNET_EXPLORER=https://mainnet.qie.digital

# QIE DEX swap URL (the "get QIE for gas" link)
VITE_QIE_DEX_URL=https://www.swap.dex.qie.digital/swap

# The domain DevStation is served from. Set it on the production site only:
# with it, devstation.online is the landing page, docs.<domain> the docs and
# console.<domain> the console, and links between them are absolute. Leave it
# empty everywhere else (local dev, previews) and every page is on one host.
# The GitHub OAuth app's callback must then be
# https://console.<domain>/api/github/callback.
VITE_ROOT_DOMAIN=

# DevStation registry addresses: per network, filled after running
# scripts/deploy.ts on each chain. The legacy VITE_*_ADDRESS (no suffix) is
# still read as the testnet fallback.
VITE_PROJECT_REGISTRY_ADDRESS_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_MAINNET=

# TemplateRegistry and DevStationMarketplace, per network. QIE mainnet (both)
# and QIE testnet (marketplace) have verified built-in defaults; set these only
# for a custom deployment. Check an address holds contract code before setting
# it: a wrong value fails silently.
# VITE_TEMPLATE_REGISTRY_ADDRESS_TESTNET=
# VITE_TEMPLATE_REGISTRY_ADDRESS_MAINNET=
# VITE_TEMPLATE_REGISTRY_ADDRESS_BOT_TESTNET=
# VITE_TEMPLATE_REGISTRY_ADDRESS_BOT_MAINNET=
# VITE_MARKETPLACE_ADDRESS_TESTNET=
# VITE_MARKETPLACE_ADDRESS_MAINNET=
# VITE_MARKETPLACE_ADDRESS_BOT_TESTNET=
# VITE_MARKETPLACE_ADDRESS_BOT_MAINNET=

# QIE QUSDC stablecoin (6 decimals, NOT 18). The mainnet address is verified
# and built in as the default, so this needs no configuration. QIE testnet has
# no canonical QUSDC, a dozen unofficial contracts share the symbol, so the
# testnet balance line stays hidden until an official address is published.
VITE_QUSDC_ADDRESS_MAINNET=
VITE_QUSDC_ADDRESS_TESTNET=

# QIE ID: the ".qie" name registry (an ERC-721 of domain names, not an
# identity resolver). The mainnet address is verified and built in. Only
# balanceOf() is usable: ownerOf/tokenURI/ENS-style resolution all revert.
VITE_QIE_ID_ADDRESS_MAINNET=
VITE_QIE_ID_ADDRESS_TESTNET=

# BOT Chain network config (public: safe to ship to the browser). Defaults
# match dev-docs.botchain.ai, so these are only needed to override an endpoint.
# Chain ids (968 testnet, 677 mainnet) are protocol constants.
VITE_BOT_TESTNET_RPC=https://rpc.bohr.life
VITE_BOT_TESTNET_EXPLORER=https://scan.bohr.life

VITE_BOT_MAINNET_RPC=https://rpc.botchain.ai
VITE_BOT_MAINNET_EXPLORER=https://scan.botchain.ai

# BOT DEX swap URL (the "get BOT for gas" link)
VITE_BOT_DEX_URL=https://dex.botchain.ai/#/swap

# DevStation registry addresses on BOT Chain: separate deployment from QIE's,
# filled after running `bun run scripts/deploy.ts bot <testnet|mainnet>`.
# BOT mainnet has verified built-in defaults (see DEPLOYMENT.md); BOT testnet
# is unset, so its onchain features stay hidden until these are configured.
VITE_PROJECT_REGISTRY_ADDRESS_BOT_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_BOT_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_BOT_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_BOT_MAINNET=

# Server-only: private key for scripts/deploy.ts. NEVER commit. Goes in .env.local
# PRIVATE_KEY=0x...

# --- Gas-sponsored deploys (QIE mainnet + BOT Chain mainnet only, optional) ---
# Server-only wallet, one per sponsor-eligible mainnet, that tops up a
# caller's OWN wallet with just enough native gas token to cover a deploy, so
# a visitor with zero QIE/BOT can still deploy: the caller's wallet still
# signs and broadcasts everything itself (it's a token top-up, not a
# relayer). UNLIKE PRIVATE_KEY above (a one-off local CLI key), these keys
# are held LIVE by the running server and spend real mainnet funds in
# response to requests: treat each like an exchange hot wallet: a dedicated
# wallet, funded with only what you're willing to see drained, never a
# wallet that holds other funds. Requests must be signed by the wallet the
# gas is sent to (a free personal_sign, so a zero-balance wallet can still
# do it) and are rate-limited per wallet, per IP and globally; the rolling
# 24h budget below is the final backstop. That stops an anonymous drain, but
# it does NOT make this risk-free: the token lands in the requester's wallet
# before any deploy, so nothing forces it to be spent on one: a determined
# user with several wallets can still farm it up to the daily cap. Size the
# budget accordingly. See
# DEPLOYMENT.md#sponsored-deploys-qie-mainnet--bot-chain-mainnet.
# Testnets aren't sponsored: they already have public faucets.
# SPONSOR_PRIVATE_KEY=0x...
# SPONSOR_DAILY_BUDGET_QIE=5              # rolling 24h spend ceiling, whole QIE
# SPONSOR_PRIVATE_KEY_BOT=0x...
# SPONSOR_DAILY_BUDGET_BOT=5              # rolling 24h spend ceiling, whole BOT
# Hard cap on any single top-up, in whole native tokens. A request whose gas
# estimate would need more is refused rather than funded, so one request cannot
# take a large share of the day's budget.
# SPONSOR_MAX_TOPUP_NATIVE=0.3                # default 0.3

# =====================================================================
# AI assistant (Code with AI)
# =====================================================================
# DevStation defaults to OPENROUTER, because one OpenRouter key reaches every
# model in the app's picker: Claude, GPT, DeepSeek, Gemini, Grok and Qwen -
# so you don't need an account per vendor. Users can still switch provider and
# paste their own key at runtime in the AI panel's settings.
#
# RECOMMENDED SETUP (server proxy: the key never reaches the browser):
#   1. VITE_AI_PROXY=true          (public flag: route through /api/ai)
#   2. OPENROUTER_API_KEY=sk-or-v1-...   (server-only, NOT VITE_-prefixed)
# That's it. Everything below is optional.
#
# VITE_AI_PROXY=true
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_MODEL=anthropic/claude-sonnet-5   # optional; any OpenRouter model id
#
# Bring-your-own-key users paste their key in the AI panel; it stays in their
# browser. There is deliberately no VITE_ variable for an AI key: anything
# VITE_-prefixed is inlined into the bundle every visitor downloads.
#
# /api/ai requires the visitor's one-time wallet sign-in, like the agent
# endpoints, and is rate-limited per wallet.
#
# Output-token caps. AI_MAX_TOKENS (proxy) defaults to 32000 and is clamped to
# 64000. VITE_AI_MAX_TOKENS caps direct (bring-your-own-key) requests, default
# 16000; it is a public number, not a secret.
# AI_MAX_TOKENS=32000
# VITE_AI_MAX_TOKENS=16000
#
# --- Optional: other server-only proxy backends (NEVER VITE_-prefixed) --
# AI_PROVIDER=openai               # "openai" (incl. OpenRouter) or "anthropic"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_ENDPOINT=https://api.anthropic.com
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=

# ── Shared rate limits ───────────────────────────────────────────────────────
#
# The limits on the endpoints that spend the operator's money (/api/ai, gas
# top-ups, builds, deploys) are kept in Upstash Redis when these are set, so
# they hold across serverless instances. Without them each instance falls back
# to its own in-memory counters, which a distributed caller can multiply: set
# them on any multi-instance (serverless) host.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Which request header carries the real client address. Per-IP limits read
# only this one header, because any other "client IP" header can be written by
# the client. Defaults: x-vercel-forwarded-for on Vercel, otherwise Netlify's
# x-nf-client-connection-ip. Set it on any other host (for example
# cf-connecting-ip behind Cloudflare, or x-real-ip behind an nginx that sets
# it), or every visitor shares one per-IP bucket.
# TRUSTED_IP_HEADER=

# ── Hosting published apps on Netlify (optional) ─────────────────────────────
#
# Lets "Deploy to Netlify" publish a user's app under the operator's account.
# BLAST RADIUS: the token can act on every site its account can reach. Use a
# token belonging to a DEDICATED Netlify team that holds only user apps, never
# the account that hosts DevStation itself, and set NETLIFY_ACCOUNT_SLUG to that
# team. Users can always deploy with their own token instead.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_ACCOUNT_SLUG=

# Build runner (services/runner). Without these the App Builder still works -
# it generates apps that run with no build step, but it cannot install
# packages, lint, or test in a browser.
#
# RUNNER_URL is where the runner listens; RUNNER_TOKEN is its bearer token.
# The token grants the ability to run code on the runner host, so it is
# server-side only and never reaches the browser. NO VITE_ prefix, ever.
#
#   local dev, runner on the same machine:  http://127.0.0.1:8792
#   deployed (Netlify, etc.):               https://backend.devstation.online
#
# A deployed site cannot reach loopback on the runner's host, which is the
# whole reason the public hostname exists.
RUNNER_URL=
# At least 32 characters (openssl rand -hex 32). The runner refuses a shorter one.
RUNNER_TOKEN=

# Read-only dashboard at the runner's own URL. A SEPARATE credential from
# RUNNER_TOKEN on purpose: that token runs code, this one only views. Unset
# means the dashboard is off, not open. Set on the runner host, not here.
# DASHBOARD_PASSWORD=

# Block-explorer TLS fallback. OFF by default: set to 1 only while a chain's
# explorer certificate is invalid.
#
# QIE's explorer certificates expired on 2026-08-30 and were renewed on
# 2026-09-03; the fallback stays available for the next lapse. With this on,
# a server-side explorer GET that fails ON THE CERTIFICATE is retried once with
# verification disabled, but only for a host that appears in this app's own
# chain config, never an arbitrary URL, and never for a POST.
#
# The trade: a relaxed request keeps its encryption but loses authentication, so
# someone on the network path could serve false block data (a wrong balance, or
# a transaction shown as confirmed when it is not). No credential is ever sent
# to these hosts. It self-heals: once the certificate is renewed the strict
# attempt succeeds and the fallback stops being reached.
#
# EXPLORER_ALLOW_EXPIRED_CERT=1   # retry a cert-failed explorer GET unverified

# GitHub sign-in (App Builder -> push an app to a repository).
#
# An OAuth App, NOT a fine-grained token: only an OAuth token can create a
# repository (POST /user/repos) and read the signed-in account (GET /user),
# which is what makes "connect once, then push" possible at all.
#
# Register at https://github.com/settings/developers -> New OAuth App.
#
# ONE app covers every environment: an OAuth App accepts up to 10 Redirect URIs,
# each in its own field. redirect_uri is derived from the request origin, so the
# same build works everywhere its origin is listed. Add an entry per origin -
# and ADD, do not replace, or sign-in breaks on the origin you dropped:
#
#   https://devstation-app-builder.netlify.app/api/github/callback
#   https://devstation.online/api/github/callback
#   https://devstation.<runner-ip-with-dashes>.sslip.io/api/github/callback
#
# Leave "Allow wildcard matching" OFF. It would let tokens reach any subdomain
# or sub-path of a registered URI, which is a real widening for no benefit when
# exact URLs will do.
#
# The secret is server-only and must never carry a VITE_ prefix: the access
# token it produces can create and write repositories on a user's account.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the session cookie and the CSRF state. Superseded by SESSION_SECRET
# below; still honoured so an existing deployment does not sign everyone out.
# GITHUB_SESSION_SECRET=


# ── Sessions and access grants ───────────────────────────────────────────────
#
# Signs the GitHub session cookie AND the access-grant cookie that authorises
# the endpoints which spend money (starting an agent run, building, publishing).
# Set this. Without it, sessions fall back to signing with the OAuth client
# secret -- one secret doing two jobs, so rotating the OAuth app silently logs
# everyone out -- and access grants fall back to RUNNER_TOKEN, or to a
# per-process key that does not survive a restart.
#
# REQUIRED on the runner too (set it in the runner's environment): it signs the
# email verification codes, and the runner refuses to start without
# SESSION_SECRET or RUNNER_TOKEN.
#
#   openssl rand -hex 32
SESSION_SECRET=


# ── Agent pricing ────────────────────────────────────────────────────────────
#
# Rates per million tokens, used to enforce a run's dollar budget. Defaults come
# from a per-model table (src/lib/agent/pricing.ts) and are only worth setting
# when published prices change before that table does. Each overrides one rate.
# AGENT_INPUT_COST=
# AGENT_OUTPUT_COST=
# AGENT_CACHE_READ_COST=
# AGENT_CACHE_WRITE_COST=


# ── Agent sandbox ────────────────────────────────────────────────────────────
#
# Commands the agent runs go inside a container. On by default; these exist for
# machines where that is not possible or not yet set up.
#
# DEVSTATION_SANDBOX=off            # run commands on this machine, unsandboxed
# DEVSTATION_SANDBOX_IMAGE=devstation-sandbox:1
# DEVSTATION_SANDBOX_RUNTIME=runc   # default runsc (gVisor); runc has a weaker boundary


# ── Build runner (services/runner) ───────────────────────────────────────────
#
# Read by the runner process itself, not by the app. RUNNER_URL and RUNNER_TOKEN
# above are how the app reaches it.
#
# RUNNER_HOST=127.0.0.1
# PORT=8792
# RUNNER_IMAGE=devstation-runner:3
# RUNNER_RUNTIME=runsc
# Where every piece of runner state lives: jobs, history, accounts, listings,
# activity. One directory, so a host migration moves all of it. STATE_DIRECTORY
# (what systemd's StateDirectory= sets) is read as an alias when this is unset.
# Default /var/lib/devstation-runner.
# RUNNER_STATE_DIR=
# PUBLISH_DIR=
# Email verification (Resend). Unset means email verification is off.
# RESEND_API_KEY=
# MAIL_FROM=DevStation <noreply@devstation.online>
# Network access for commands the Coding Agent runs in a workspace container.
# On by default (installs need it); set to off to seal workspaces.
# DEVSTATION_WORKSPACE_NETWORK=on
# Enables the runner's own dashboard. Unset means the dashboard is off (404),
# not open.
# DASHBOARD_PASSWORD=


# ── Contract deployment (scripts/deploy.ts) ──────────────────────────────────
#
# Only needed to deploy the registries yourself. Never commit a real value.
# PRIVATE_KEY=


# ── Server-side AI aliases and tuning ────────────────────────────────────────
#
# The /api/ai proxy reads OPENROUTER_API_KEY / OPENAI_* first; these are the
# older aliases it still honours, plus the knobs that have no VITE_ twin.
# AI_API_KEY=                  # alias for OPENAI_API_KEY
# AI_MODEL=                    # alias for OPENAI_MODEL
# AI_ENDPOINT=                 # alias for OPENAI_ENDPOINT
# AI_MAX_TOKENS=
# AI_REASONING=                # reasoning effort for models that take one
# ANTHROPIC_MAX_TOKENS=
# ANTHROPIC_EFFORT=


# ── DevStation CLI ───────────────────────────────────────────────────────────
#
# Read by the `devstation` command, not by the web app.
#
# A token for the CLI's own GitHub operations. GH_TOKEN is accepted as an
# alias, so an existing `gh` login works without setting anything new.
# GITHUB_TOKEN=
# Where `bun run build:cli` writes its binaries.
# CLI_OUT_DIR=dist-cli


# ── Unsandboxed runner escape hatch ──────────────────────────────────────────
#
# The app refuses to send agent runs to a runner that does not report a ready
# agent sandbox, because such a runner would execute model-chosen commands on
# its own host with nothing around them. Set this to 1 only for a local runner
# with no Docker, where you have decided that is acceptable.
#
# An environment variable rather than a request field on purpose: a caller must
# never be able to ask to be run unisolated.
# ALLOW_UNSANDBOXED_RUNNER=1
