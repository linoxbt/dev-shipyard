# QIE network config (public — safe to ship to the browser). Defaults match
# docs.qie.digital, so these are optional overrides.
VITE_QIE_TESTNET_RPC=https://rpc1testnet.qie.digital/
VITE_QIE_TESTNET_EXPLORER=https://testnet.qie.digital
VITE_QIE_TESTNET_CHAIN_ID=1983

VITE_QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital/
VITE_QIE_MAINNET_EXPLORER=https://mainnet.qie.digital
VITE_QIE_MAINNET_CHAIN_ID=1990

# QIE DEX swap URL (the "get QIE for gas" link)
VITE_QIE_DEX_URL=https://www.swap.dex.qie.digital/swap

# DevStation registry addresses — per network, filled after running
# scripts/deploy.ts on each chain. The legacy VITE_*_ADDRESS (no suffix) is
# still read as the testnet fallback.
VITE_PROJECT_REGISTRY_ADDRESS_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_MAINNET=

# QIE QUSDC stablecoin address — obtain from docs.stable.qie.digital / explorer.
# When unset, the QUSDC balance line is hidden.
VITE_QUSDC_ADDRESS=

# BOT Chain network config (public — safe to ship to the browser). Defaults
# match dev-docs.botchain.ai, so these are only needed to override an endpoint.
VITE_BOT_TESTNET_RPC=https://rpc.bohr.life
VITE_BOT_TESTNET_EXPLORER=https://scan.bohr.life
VITE_BOT_TESTNET_CHAIN_ID=968

VITE_BOT_MAINNET_RPC=https://rpc.botchain.ai
VITE_BOT_MAINNET_EXPLORER=https://scan.botchain.ai
VITE_BOT_MAINNET_CHAIN_ID=677

# BOT DEX swap URL (the "get BOT for gas" link)
VITE_BOT_DEX_URL=https://dex.botchain.ai/#/swap

# DevStation registry addresses on BOT Chain — separate deployment from QIE's,
# filled after running `bun run scripts/deploy.ts bot <testnet|mainnet>`.
# Unset by default: onchain features (Projects, Label Registry, ecosystem
# stats) stay hidden on BOT Chain until these are configured.
VITE_PROJECT_REGISTRY_ADDRESS_BOT_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_BOT_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_BOT_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_BOT_MAINNET=

# X Layer (OKX's L2). Explorer is OKLink, not Blockscout — DevStation's
# internal explorer dashboard isn't available for this chain, only
# wallet/deploy/registry support.
VITE_XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech/terigon
VITE_XLAYER_TESTNET_EXPLORER=https://www.oklink.com/xlayer-testnet
VITE_XLAYER_TESTNET_CHAIN_ID=1952
VITE_XLAYER_MAINNET_RPC=https://rpc.xlayer.tech
VITE_XLAYER_MAINNET_EXPLORER=https://www.oklink.com/xlayer
VITE_XLAYER_MAINNET_CHAIN_ID=196
VITE_PROJECT_REGISTRY_ADDRESS_XLAYER_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_XLAYER_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_XLAYER_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_XLAYER_MAINNET=

# Arc (Circle's stablecoin-native L1). Testnet only — no mainnet yet.
VITE_ARC_TESTNET_RPC=https://rpc.testnet.arc.network
VITE_ARC_TESTNET_EXPLORER=https://testnet.arcscan.app
VITE_ARC_TESTNET_CHAIN_ID=5042002
VITE_PROJECT_REGISTRY_ADDRESS_ARC_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_ARC_TESTNET=

# Avalanche. Explorer is Snowtrace/Routescan, not Blockscout — DevStation
# talks to Routescan's API directly instead (full dashboard support).
# Testnet RPC uses publicnode's mirror: the official api.avax-test.network
# sits behind Cloudflare bot protection that blocks server-side requests.
VITE_AVALANCHE_TESTNET_RPC=https://avalanche-fuji-c-chain-rpc.publicnode.com
VITE_AVALANCHE_TESTNET_EXPLORER=https://testnet.snowtrace.io
VITE_AVALANCHE_TESTNET_CHAIN_ID=43113
VITE_AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
VITE_AVALANCHE_MAINNET_EXPLORER=https://snowtrace.io
VITE_AVALANCHE_MAINNET_CHAIN_ID=43114
VITE_PROJECT_REGISTRY_ADDRESS_AVALANCHE_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_AVALANCHE_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_AVALANCHE_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_AVALANCHE_MAINNET=

# GOAT Network (Bitcoin L2, gas paid in BTC). Runs Blockscout.
VITE_GOAT_TESTNET_RPC=https://rpc.testnet3.goat.network
