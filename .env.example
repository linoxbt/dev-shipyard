VITE_GOAT_TESTNET_CHAIN_ID=48816
VITE_GOAT_MAINNET_RPC=https://rpc.goat.network
VITE_GOAT_MAINNET_EXPLORER=https://explorer.goat.network
VITE_GOAT_MAINNET_CHAIN_ID=2345
VITE_PROJECT_REGISTRY_ADDRESS_GOAT_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_GOAT_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_GOAT_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_GOAT_MAINNET=

# Arbitrum. Gas is paid in ETH (ARB is a separate governance-only token).
# Uses a community Blockscout mirror since the official Arbiscan explorer
# isn't Blockscout-compatible.
VITE_ARBITRUM_TESTNET_RPC=https://sepolia-rollup.arbitrum.io/rpc
VITE_ARBITRUM_TESTNET_EXPLORER=https://arbitrum-sepolia.blockscout.com
VITE_ARBITRUM_TESTNET_CHAIN_ID=421614
VITE_ARBITRUM_MAINNET_RPC=https://arb1.arbitrum.io/rpc
VITE_ARBITRUM_MAINNET_EXPLORER=https://arbitrum.blockscout.com
VITE_ARBITRUM_MAINNET_CHAIN_ID=42161
VITE_PROJECT_REGISTRY_ADDRESS_ARBITRUM_TESTNET=
VITE_PROJECT_REGISTRY_ADDRESS_ARBITRUM_MAINNET=
VITE_LABEL_REGISTRY_ADDRESS_ARBITRUM_TESTNET=
VITE_LABEL_REGISTRY_ADDRESS_ARBITRUM_MAINNET=

# Server-only: private key for scripts/deploy.ts. NEVER commit. Goes in .env.local
# PRIVATE_KEY=0x...

# --- Gas-sponsored deploys (QIE mainnet + BOT Chain mainnet only, optional) ---
# Server-only wallet, one per sponsor-eligible mainnet, that tops up a
# caller's OWN wallet with just enough native gas token to cover a deploy, so
# a visitor with zero QIE/BOT can still deploy — the caller's wallet still
# signs and broadcasts everything itself (it's a token top-up, not a
# relayer). UNLIKE PRIVATE_KEY above (a one-off local CLI key), these keys
# are held LIVE by the running server and spend real mainnet funds in
# response to requests — treat each like an exchange hot wallet: a dedicated
# wallet, funded with only what you're willing to see drained, never a
# wallet that holds other funds. There is deliberately no per-wallet/per-IP
# gate on who can request a top-up (see
# DEPLOYMENT.md#sponsored-deploys-qie-mainnet--bot-chain-mainnet) — since the
# native token lands directly in the requester's own wallet, this is closer
# to an open faucet than a scoped gas payer, and the daily budget below is
# the only backstop. NEVER set either key below unless you understand and
# accept that. Testnets aren't sponsored — they already have public faucets.
# SPONSOR_PRIVATE_KEY=0x...
# SPONSOR_DAILY_BUDGET_QIE=5              # rolling 24h spend ceiling, whole QIE
# SPONSOR_PRIVATE_KEY_BOT=0x...
# SPONSOR_DAILY_BUDGET_BOT=5              # rolling 24h spend ceiling, whole BOT

# AI assistant (Code with AI). Two providers; the user can also switch and paste
# a key in the panel's settings at runtime. Keys here ship to the browser, so use
# a personal key, not a shared production one.
#
# Which provider to default to: "anthropic" or "openai". If unset, defaults to
# whichever has a key below (tie-break: anthropic).
VITE_AI_PROVIDER=anthropic
#
# Anthropic (native Claude Messages API):
VITE_ANTHROPIC_API_KEY=
VITE_ANTHROPIC_MODEL=claude-opus-4-8
# VITE_ANTHROPIC_ENDPOINT=https://api.anthropic.com   # override for a proxy
#
# OpenAI-compatible (/chat/completions):
VITE_AI_ENDPOINT=
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4o-mini

# --- Server proxy: provide a default AI key for all users (recommended) ---
# Set VITE_AI_PROXY=true so the browser calls this app's /api/ai route instead
# of the provider directly. The keys below have NO VITE_ prefix, so Vite never
# inlines them into the client bundle — they stay server-side. In the app's AI
# settings, users then choose "Provided default" (this key) or "Use my own key".
# VITE_AI_PROXY=true
#
# EASIEST: one OpenRouter key powers the default. Set this in the Netlify/Vercel
# dashboard (server-only, NOT VITE_-prefixed) plus VITE_AI_PROXY=true:
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_MODEL=openai/gpt-4o-mini   # optional; any OpenRouter model id
#
# Other server-only options (NEVER VITE_-prefixed):
# AI_PROVIDER=anthropic            # or "openai"; defaults to whichever key is set
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_ENDPOINT=https://api.anthropic.com
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
