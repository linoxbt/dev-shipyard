# Port to listen on.
PORT=8787
# The publicly reachable base URL of THIS server — used to build the image /
# metadata URLs returned by /upload (so they resolve on-chain). No trailing slash.
PUBLIC_URL=http://localhost:8787
# Optional: path to the anchor binary if not on PATH.
# ANCHOR_BIN=anchor
# Shared secret required on POST /build and POST /upload. STRONGLY recommended
# whenever this server is reachable on a public address — /build compiles
# arbitrary submitted Rust. Leave unset to disable the check (local use only).
# The app must send the same value via VITE_SOLANA_BUILD_TOKEN.
BUILD_API_TOKEN=
